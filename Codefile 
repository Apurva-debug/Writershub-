<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WritersClub</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>
<div class="wrap">
  <header class="top">
    <span class="spine-mark"></span>
    <span class="brand">WritersClub</span>
  </header>

  <div class="hero">
    <h1>Find the reader your book actually needs.</h1>
    <p>A place for new Wattpad writers to trade genuine support — matched by
    genre, tracked fairly, no separate fan base required.</p>
  </div>

  <div class="field">
    <p style="margin-bottom:18px;">Every member signs up with the Wattpad account they already write on, so the club stays writers-only.</p>
  </div>

  <a class="btn btn-primary" href="signup.html" style="margin-bottom:12px;">Join with your Wattpad account</a>
  <button class="btn btn-ghost" id="returningBtn">I already have an account</button>

  <div class="section-label">How it works</div>
  <div class="card">
    <div class="book-title">1. Tell us your book</div>
    <div class="book-meta">Its genre, and what you love reading yourself.</div>
  </div>
  <div class="card">
    <div class="book-title">2. Get matched</div>
    <div class="book-meta">By genre fit — mutual pairing, or open matching if you're confident your book stands on its own.</div>
  </div>
  <div class="card">
    <div class="book-title">3. Support each other, on record</div>
    <div class="book-meta">Both sides confirm the task is done — no one has to take it on faith.</div>
  </div>

  <footer class="note">This is an early, single-device prototype — accounts are stored on this phone only for now.</footer>
</div>

<script src="app.js"></script>
<script>
  WC.ensureSeedUsers();
  document.getElementById('returningBtn').addEventListener('click', () => {
    const u = WC.getCurrentUser();
    if (u && u.bookTitle) {
      window.location.href = 'dashboard.html';
    } else {
      alert("No account found on this phone yet — let's get you signed up.");
      window.location.href = 'signup.html';
    }
  });
</script>
</body>
</html>